{
  "name": "gitlab-job-starter",
  "version": "1.10.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "package": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "wxt prepare && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.309",
    "happy-dom": "^20.9.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "vitest": "^2.1.8",
    "wxt": "0.20.26"
  }
}
